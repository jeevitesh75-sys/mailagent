# Copy these names into Netlify > Site configuration > Environment variables.
# Never put real values in this file or in GitHub.

# --- Required ---
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=16 letters from myaccount.google.com/apppasswords
GROQ_API_KEY=from console.groq.com/keys
ADMIN_KEY=any random text, 20 or more characters (opens the test page)

# --- Choose how it works ---
# draft = it saves each reply as a Gmail draft and you press Send (safe, recommended first)
# send  = it sends replies by itself
MODE=draft

# --- Optional ---
BUSINESS_NAME=Your Business
SIGNATURE=Thanks,\nYour Business
TONE=friendly and professional
GROQ_MODEL=llama-3.1-8b-instant
MAX_PER_RUN=5
MAX_PER_SENDER_PER_DAY=2
DAILY_SEND_CAP=100
LOOKBACK_DAYS=2
UNKNOWN_ACTION=flag
# BUSINESS_INFO=  (only if you do not want to use the file knowledge.txt)
